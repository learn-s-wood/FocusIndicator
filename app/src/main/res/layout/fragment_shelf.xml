<?xml version="1.0" encoding="utf-8"?>
<!--
    内容页（多行横向列表）：电视上最常见的形态，每行自己横向滚动。

    外层容器负责画焦点指示；中间 LinearLayout 只是把三行等分排开，行是纯 RecyclerView。
    焦点策略（记行 / 记位置 / 跨区）收在宿主的 FocusHelper，布局层不含焦点逻辑。
    行用 layout_weight 等分高度，行内 item 撑满行高，行数增删不用改布局。
-->
<io.github.learnswood.focusindicator.FocusIndicatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/shelfStack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="6dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shelfRow1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:focusable="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shelfRow2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:focusable="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shelfRow3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:focusable="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
    </LinearLayout>
</io.github.learnswood.focusindicator.FocusIndicatorLayout>