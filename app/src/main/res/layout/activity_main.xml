<?xml version="1.0" encoding="utf-8"?>
<!--
    FocusIndicator Demo 布局。

    约定：
    1) item 自身不要设不透明背景 —— behind 层的实心底色画在 item 之下，会被背景盖住；
    2) 容器与所有祖先都要 clipChildren="false"，否则外扩的描边/光晕会被裁掉；
    3) item 只需要 focusable="true"，不需要任何焦点态背景或 selector。

    尺寸按 720p 电视（1280x720 / density 213 ≈ 541dp 高）压缩，整页无需滚动即可完整显示。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:keepScreenOn="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/demoContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/demo_title"
                android:textColor="@color/demo_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 入口：跳到 tab + 网格 / 交错列表示例页 -->
            <io.github.learnswood.focusindicator.FocusIndicatorLayout
                android:id="@+id/tabGridHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/btnTabGridDemo"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="16dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/demo_entry_tab_grid"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="11sp" />
            </io.github.learnswood.focusindicator.FocusIndicatorLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/demo_label_tabs"
            android:textColor="@color/demo_text_secondary"
            android:textSize="11sp" />

        <!-- 场景 1：圆角实心底色在 item 下层滑动 -->
        <io.github.learnswood.focusindicator.FocusIndicatorLayout
            android:id="@+id/fiTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tab1"
                    android:background="@drawable/bg_item_bounds"
                    android:layout_width="80dp"
                    android:layout_height="36dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/tab_recommend"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tab2"
                    android:background="@drawable/bg_item_bounds"
                    android:layout_width="80dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/tab_animation"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tab3"
                    android:background="@drawable/bg_item_bounds"
                    android:layout_width="80dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/tab_song"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />

                <!-- 这个 tab 自带焦点样式，用 tag 退出父容器的统一底色块 -->
                <TextView
                    android:id="@+id/tab4"
                    android:layout_width="80dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tab_own_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:tag="fi:ignore"
                    android:text="@string/tab_english"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </io.github.learnswood.focusindicator.FocusIndicatorLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/demo_label_cards"
            android:textColor="@color/demo_text_secondary"
            android:textSize="11sp" />

        <!-- 场景 2：不同尺寸 item + 描边飞框 -->
        <io.github.learnswood.focusindicator.FocusIndicatorLayout
            android:id="@+id/fiCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/card1"
                    android:background="@drawable/bg_item_bounds"
                    android:layout_width="64dp"
                    android:layout_height="36dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/card_small"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/card2"
                    android:background="@drawable/bg_item_bounds"
                    android:layout_width="118dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/card_medium"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/card3"
                    android:background="@drawable/bg_item_bounds"
                    android:layout_width="132dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="10dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/card_large"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/card4"
                    android:background="@drawable/bg_item_bounds"
                    android:layout_width="190dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/card_wide"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/card5"
                    android:background="@drawable/bg_item_bounds"
                    android:layout_width="82dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="10dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/card_tall"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </io.github.learnswood.focusindicator.FocusIndicatorLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/demo_label_combo"
            android:textColor="@color/demo_text_secondary"
            android:textSize="11sp" />

        <!-- 场景 3：底层实心色块 + 顶层描边，两层同步变形 -->
        <io.github.learnswood.focusindicator.FocusIndicatorLayout
            android:id="@+id/fiCombo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/combo1"
                    android:background="@drawable/bg_item_bounds"
                    android:layout_width="110dp"
                    android:layout_height="36dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/combo_one"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/combo2"
                    android:background="@drawable/bg_item_bounds"
                    android:layout_width="180dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/combo_two"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/combo3"
                    android:background="@drawable/bg_item_bounds"
                    android:layout_width="110dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/combo_three"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </io.github.learnswood.focusindicator.FocusIndicatorLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/demo_label_scale"
            android:textColor="@color/demo_text_secondary"
            android:textSize="11sp" />

        <!-- 场景 4：item 焦点态放大，飞框需逐帧贴合放大后的真实外形 -->
        <io.github.learnswood.focusindicator.FocusIndicatorLayout
            android:id="@+id/fiScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/scale1"
                    android:background="@drawable/bg_item_bounds"
                    android:layout_width="70dp"
                    android:layout_height="34dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/scale_one"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/scale2"
                    android:background="@drawable/bg_item_bounds"
                    android:layout_width="92dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="18dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/scale_two"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/scale3"
                    android:background="@drawable/bg_item_bounds"
                    android:layout_width="106dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="18dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/scale_three"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/scale4"
                    android:background="@drawable/bg_item_bounds"
                    android:layout_width="56dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="18dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/scale_four"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/scale5"
                    android:background="@drawable/bg_item_bounds"
                    android:layout_width="106dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="18dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/scale_five"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </io.github.learnswood.focusindicator.FocusIndicatorLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/demo_label_grid"
            android:textColor="@color/demo_text_secondary"
            android:textSize="11sp" />

        <!-- 场景 5：RecyclerView 网格，item 自身带背景，因此只开顶层描边 + 外发光 -->
        <io.github.learnswood.focusindicator.FocusIndicatorLayout
            android:id="@+id/fiGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gridList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false"
                android:overScrollMode="never" />
        </io.github.learnswood.focusindicator.FocusIndicatorLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/demo_tip"
            android:textColor="@color/demo_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
